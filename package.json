{
  "name": "migrants",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "ingest:json": "ts-node --project tsconfig.seed.json --transpile-only scripts/ingest-json-incidents.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node --project tsconfig.seed.json --transpile-only prisma/seed.ts",
    "ingest:iom": "ts-node --project tsconfig.seed.json --transpile-only src/ingestion/ingest-iom.command.ts",
    "ingest:hdx": "ts-node --project tsconfig.seed.json --transpile-only src/ingestion/ingest-hdx.command.ts",
    "seed:historical": "npx ts-node scripts/seed-historical-incidents.ts"
  },
  "prisma": {
    "seed": "npm run prisma:seed"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^6.16.2",
    "bullmq": "^6.3.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "csv-parser": "^3.2.1",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "handlebars": "^4.7.10",
    "ioredis": "^6.0.0",
    "puppeteer": "^25.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stream-json": "^1.9.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@types/handlebars": "^4.0.40",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.18.6",
    "@types/stream-json": "^1.7.8",
    "prisma": "^6.16.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
