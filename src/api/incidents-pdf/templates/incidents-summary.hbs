<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <title>مرجع المفقودين السوريين عبر الهجرة</title>
    <style>
      @page { size: A4 landscape; margin: 13mm; }
      * { box-sizing: border-box; }
      body { font-family: "Noto Naskh Arabic", "Amiri", "Segoe UI", Tahoma, sans-serif; color: #1a1a1a; font-size: 9pt; line-height: 1.5; margin: 0; direction: rtl; }
      h1 { font-size: 18pt; margin: 0 0 8px; }
      .totals { margin: 0 0 8px; }
      .total-value { font-size: 16pt; font-weight: 700; line-height: 1.2; }
      .total-label { color: #444; font-size: 9pt; }
      .meta { color: #666; font-size: 9pt; margin-bottom: 14px; }
      table { width: 100%; border-collapse: collapse; table-layout: fixed; }
      thead { display: table-header-group; }
      th, td { text-align: right; padding: 5px 6px; border-bottom: 1px solid #ddd; vertical-align: top; overflow-wrap: anywhere; }
      th { background: #f1f3f2; font-size: 8pt; }
      tr { page-break-inside: avoid; }
      .col-date { width: 15%; }
      .col-location { width: 14%; }
      .col-status { width: 12%; }
      .col-route { width: 12%; }
      .col-cause { width: 14%; }
      .col-count { width: 9%; }
      .col-source { width: 24%; }
      .count { font-weight: 700; }
      .source { font-size: 8pt; }
      .url, .file { display: block; margin-top: 2px; color: #555; font-size: 7pt; }
      .url { direction: ltr; text-align: right; }
      .id { display: block; direction: ltr; text-align: right; color: #777; font-size: 7pt; margin-top: 2px; }
      .badge { display: inline-block; padding: 2px 6px; border-radius: 3px; font-weight: 600; white-space: nowrap; }
      .badge.compact { font-size: 6.5pt; padding: 1px 4px; font-weight: 600; }
      .alive { background: #d4f4dd; color: #155724; }
      .deceased, .fatality { background: #f8d7da; color: #721c24; }
      .missing { background: #fff3cd; color: #856404; }
      .detained { background: #d1ecf1; color: #0c5460; }
      .conflict { background: #fde2e4; color: #842029; }
      .unknown { background: #e2e3e5; color: #383d41; }
      .muted { color: #888; }
      .empty { text-align: center; padding: 28px; color: #666; }
    </style>
  </head>
  <body>
    <h1>مرجع المفقودين السوريين عبر الهجرة</h1>
    <div class="totals">
      <div class="total-value">{{totalCasualties}}</div>
      <div class="total-label">إجمالي الضحايا</div>
    </div>
    <div class="meta">عدد الحوادث: {{total}} · من عام 2011 · تاريخ الإنشاء: {{generatedAt}}</div>
    {{#if incidents.length}}
      <table>
        <thead>
          <tr>
            <th class="col-date">التاريخ ورقم السجل</th>
            <th class="col-location">الموقع</th>
            <th class="col-status">الحالة</th>
            <th class="col-route">المسار</th>
            <th class="col-cause">السبب</th>
            <th class="col-count">عدد الضحايا</th>
            <th class="col-source">مصدر المعلومة</th>
          </tr>
        </thead>
        <tbody>
          {{#each incidents}}
            <tr>
              <td>{{#if date}}{{formatDate date}}{{else}}غير معروف{{/if}}<span class="id">{{#if sourceRecordId}}{{sourceRecordId}}{{else}}{{id}}{{/if}}</span></td>
              <td>{{#if location}}{{location}}{{else}}<span class="muted">غير معروف</span>{{/if}}</td>
              <td><span class="badge {{summaryStatusClass status}}">{{translateStatus status}}</span></td>
              <td>{{#if route}}{{route}}{{else}}—{{/if}}</td>
              <td>{{#if causeOfDeath}}{{causeOfDeath}}{{else}}—{{/if}}</td>
              <td class="count">{{#if (hasValue peopleCount)}}{{peopleCount}}{{else}}—{{/if}}</td>
              <td class="source">
                <div>{{#if sourceName}}{{sourceName}}{{else}}<span class="muted">غير معروف</span>{{/if}}</div>
                {{#if sourceUrl}}<div class="url">{{sourceUrl}}</div>{{/if}}
                {{#if sourceFileName}}<div class="file">{{sourceFileName}}</div>{{/if}}
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    {{else}}
      <div class="empty">لا توجد حوادث مسجلة.</div>
    {{/if}}
  </body>
</html>